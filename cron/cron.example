#
# Or add manually with the same block below.
# Ensure cron is running in WSL:
#   service cron status

# === OpenClaw container ops ===
*/15 * * * * . /home/leandro/openclaw/config/alerts.env && /home/leandro/openclaw-container/scripts/healthcheck_notify.sh >> /home/leandro/openclaw/logs/healthcheck.log 2>&1
10 6 * * * . /home/leandro/openclaw/config/alerts.env && /home/leandro/openclaw-container/scripts/daily_maintenance.sh >> /home/leandro/openclaw/logs/daily-maintenance.log 2>&1
0 3 * * 0 /home/leandro/openclaw-container/scripts/backup.sh >> /home/leandro/openclaw/logs/backup.log 2>&1
30 3 * * * /home/leandro/openclaw-container/scripts/update.sh >> /home/leandro/openclaw/logs/update.log 2>&1
# Model routing policy refresh:
# - baseline after update
45 3 * * * /home/leandro/openclaw-container/scripts/model_router.py --objective cost_optimized --probe --apply >> /home/leandro/openclaw/logs/model-router.log 2>&1
# - business hours: balanced mode
5 8 * * 1-5 /home/leandro/openclaw-container/scripts/model_router.py --objective balanced_default --probe --apply >> /home/leandro/openclaw/logs/model-router.log 2>&1
# - off-hours: optimize cost
5 20 * * * /home/leandro/openclaw-container/scripts/model_router.py --objective cost_optimized --probe --apply >> /home/leandro/openclaw/logs/model-router.log 2>&1
15 4 * * * /home/leandro/openclaw-container/scripts/prune_logs.sh >> /home/leandro/openclaw/logs/prune.log 2>&1
# === /OpenClaw container ops ===

