{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openclaw.local/schemas/event.schema.json",
  "title": "AgentOSEvent",
  "type": "object",
  "required": [
    "eventVersion",
    "eventType",
    "eventId",
    "createdAt",
    "correlationId",
    "taskId",
    "source",
    "routing",
    "payload",
    "evidenceRefs"
  ],
  "properties": {
    "eventVersion": { "type": "string" },
    "eventType": { "type": "string", "minLength": 1 },
    "eventId": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string" },
    "role": { "type": "string" },
    "correlationId": { "type": "string", "minLength": 1 },
    "taskId": { "type": "string", "minLength": 1 },
    "source": { "type": "object" },
    "routing": { "type": "object" },
    "payload": { "type": "object" },
    "evidenceRefs": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": true
}
