# Blue profile defaults (production path)
# Copy to compose/blue.env and adjust only if needed.

OPENCLAW_IMAGE=openclaw-secure:latest
OPENCLAW_NETWORK_NAME=openclaw_internal

BLUE_CONTAINER_NAME=openclaw
BLUE_RUNTIME_ENV_FILE=./empty.env
BLUE_DATA_DIR=/home/leandro/openclaw/data
BLUE_RUNTIME_DIR=/home/leandro/openclaw/runtime
BLUE_GEMINI_DIR=/home/leandro/openclaw/runtime/gemini
BLUE_LOGS_DIR=/home/leandro/openclaw/logs
BLUE_WORKSPACE_DIR=/home/leandro/clawd
BLUE_GATEWAY_PORT=18789
